# Supabase — Project Settings → API
EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Google Maps (Android only; iOS uses Apple Maps via expo-maps).
# Read by app.config.ts at prebuild time and written into AndroidManifest.xml.
# It must be a real key: without one the map tab renders as a blank grey grid
# with the pins over nothing, and the only clue is an authorisation failure in
# logcat. For a CI build, set it as the GOOGLE_MAPS_ANDROID_KEY repository
# secret instead — see the APK section of the README.
GOOGLE_MAPS_ANDROID_KEY=AIza...
