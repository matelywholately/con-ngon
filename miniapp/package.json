{
  "name": "bua-kip-zalo-miniapp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --mode demo --host 127.0.0.1 --port 3000 --strictPort",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build && node scripts/package.mjs",
    "build:demo": "tsc --noEmit && vite build --mode demo && node scripts/package.mjs",
    "check": "npm run build && node --test tests/*.test.mjs",
    "deploy:testing": "node scripts/deploy.mjs"
  },
  "dependencies": {
    "qrcode": "1.5.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "zmp-sdk": "2.53.0"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.6",
    "@types/react": "~19.2.2",
    "@types/react-dom": "~19.2.3",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "~6.0.3",
    "vite": "8.3.3",
    "zmp-cli": "4.0.3"
  }
}
